{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtd-inbox",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Dashboard SPA: the Vite build output (`npm run build`).
  // Requests to /api/* and /telegram/* always hit the Worker; everything else is served from assets.
  "assets": {
    "directory": "./dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtd",
      // Production database (`npx wrangler d1 create gtd`, README step 3). Not a secret.
      "database_id": "99bdad50-640d-4bde-86e9-1beeffa4ab5f",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret config. Secrets (TELEGRAM_*, ALLOWED_CHAT_ID, GCP_SERVICE_ACCOUNT_JSON, GCP_PROJECT_ID)
  // are set with `wrangler secret put` in production and .dev.vars locally.
  "vars": {
    "GCP_LOCATION": "global",
    "GEMINI_MODEL": "gemini-3.8-flash",
    // Classification is simple; the model default thinks far longer than needed (slower, pricier).
    "GEMINI_THINKING_LEVEL": "low",
    "TIMEZONE": "Europe/Bratislava",
    // Cloudflare Access for the dashboard API (README step 8). Not secrets. While either is empty,
    // /api/* answers 503 everywhere except `wrangler dev` on localhost. AUD = the whole-site app, not the webhook bypass app.
    "ACCESS_TEAM_DOMAIN": "lukpox01",
    "ACCESS_AUD": "f09df2a500605f13001c48644c1d567d806e037ca2d75c1502343927cbd4ef4d"
  }
}
